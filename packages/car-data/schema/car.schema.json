{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex-motorsport/schema/car.schema.json",
  "title": "claude-car v2 car file (.ctcar.json)",
  "type": "object",
  "required": ["format", "version", "model", "paint", "parts", "tune"],
  "properties": {
    "format": { "const": "claude-car" },
    "version": { "const": 2 },
    "id": { "type": "string" },
    "name": { "type": "string", "maxLength": 48 },
    "model": { "type": "object", "required": ["id"], "properties": { "id": { "type": "string" }, "assetVersion": { "type": "integer", "minimum": 1 } } },
    "paint": {
      "type": "object",
      "properties": {
        "body": { "$ref": "#/$defs/paint" }, "accent": { "$ref": "#/$defs/paint" },
        "caliper": { "$ref": "#/$defs/color" }
      }
    },
    "livery": { "type": "object", "properties": { "layers": { "type": "array", "maxItems": 64 } } },
    "parts": { "type": "object", "additionalProperties": { "type": "object", "required": ["id"], "properties": { "id": { "type": "string" } } } },
    "tune": {
      "type": "object",
      "properties": { "gear": { "$ref": "#/$defs/unit" }, "aero": { "$ref": "#/$defs/unit" }, "ride": { "$ref": "#/$defs/unit" },
                      "susp": { "$ref": "#/$defs/unit" }, "bias": { "$ref": "#/$defs/unit" }, "diff": { "$ref": "#/$defs/unit" } }
    },
    "spec": { "type": "object" },
    "specHash": { "type": "string" }
  },
  "$defs": {
    "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "unit": { "type": "number", "minimum": 0, "maximum": 1 },
    "paint": { "type": "object", "required": ["color"], "properties": {
      "color": { "$ref": "#/$defs/color" }, "finish": { "enum": ["gloss", "metallic", "pearl", "satin", "matte", "chrome"] },
      "flake": { "$ref": "#/$defs/unit" }, "clearcoat": { "$ref": "#/$defs/unit" } } }
  }
}
